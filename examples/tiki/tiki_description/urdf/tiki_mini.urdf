<?xml version="1.0"?>
<!-- tiki_mini.urdf — generated by tools/gen_model.py from python/tiki/data/robot.json (do not edit).
     차체·바퀴·캐스터 메시는 기구 도면(STEP)에서, 바퀴·LiDAR 조인트는 제조사 URDF에서 가져왔고,
     카메라·IMU·OLED·LED 프레임은 교재 기반 추정값입니다.
     base_footprint(바닥, 바퀴축 중심 아래) -> base_link(바퀴축 높이 0.0325 m). x 앞, y 왼쪽, z 위 (REP-103). -->
<robot name="tiki_mini">
  <material name="black"><color rgba="0.15 0.155 0.17 1"/></material>
  <material name="yellow"><color rgba="0.96 0.72 0.04 1"/></material>
  <material name="vent"><color rgba="0.08 0.08 0.09 1"/></material>
  <material name="rubber"><color rgba="0.11 0.11 0.12 1"/></material>
  <material name="hub"><color rgba="0.28 0.29 0.31 1"/></material>
  <material name="camera"><color rgba="0.06 0.06 0.07 1"/></material>
  <material name="steel"><color rgba="0.75 0.76 0.78 1"/></material>
  <material name="lidar"><color rgba="0.16 0.17 0.19 1"/></material>
  <material name="oled_bezel"><color rgba="0.04 0.04 0.045 1"/></material>
  <material name="led"><color rgba="0.92 0.92 0.9 1"/></material>
  <material name="oled_screen"><color rgba="0.05 0.13 0.22 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.0325" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual><geometry><mesh filename="package://tiki_description/meshes/cad_body.stl"/></geometry><material name="black"/></visual>
    <visual><geometry><mesh filename="package://tiki_description/meshes/cad_cover.stl"/></geometry><material name="yellow"/></visual>
    <visual><geometry><mesh filename="package://tiki_description/meshes/cad_internals.stl"/></geometry><material name="vent"/></visual>
    <visual><geometry><mesh filename="package://tiki_description/meshes/cad_hardware.stl"/></geometry><material name="steel"/></visual>
    <visual><geometry><mesh filename="package://tiki_description/meshes/camera.stl"/></geometry><material name="camera"/></visual>
    <collision>
      <origin xyz="-0.0694 0 0.0030"/>
      <geometry><box size="0.222 0.216 0.0500"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0694 0 0.0030"/>
      <mass value="2.0"/>
      <inertia ixx="8.1927e-03" ixy="0" ixz="0" iyy="8.6307e-03" iyz="0" izz="1.5990e-02"/>
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual><geometry><mesh filename="package://tiki_description/meshes/cad_tire.stl"/></geometry><material name="rubber"/></visual>
    <visual><geometry><mesh filename="package://tiki_description/meshes/cad_hub.stl"/></geometry><material name="hub"/></visual>
    <collision><origin rpy="1.570796 0 0"/><geometry><cylinder radius="0.0325" length="0.0265"/></geometry></collision>
    <inertial><mass value="0.08"/><inertia ixx="2.581e-05" ixy="0" ixz="0" iyy="4.225e-05" iyz="0" izz="2.581e-05"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel_link"/>
    <origin xyz="0 0.0962 0" rpy="0 0 0.000000"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual><geometry><mesh filename="package://tiki_description/meshes/cad_tire.stl"/></geometry><material name="rubber"/></visual>
    <visual><geometry><mesh filename="package://tiki_description/meshes/cad_hub.stl"/></geometry><material name="hub"/></visual>
    <collision><origin rpy="1.570796 0 0"/><geometry><cylinder radius="0.0325" length="0.0265"/></geometry></collision>
    <inertial><mass value="0.08"/><inertia ixx="2.581e-05" ixy="0" ixz="0" iyy="4.225e-05" iyz="0" izz="2.581e-05"/></inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel_link"/>
    <origin xyz="0 -0.0962 0" rpy="0 0 3.141593"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="caster_link">
    <visual><geometry><mesh filename="package://tiki_description/meshes/cad_caster.stl"/></geometry><material name="hub"/></visual>
    <collision><origin xyz="-0.1515 0.047 -0.0265"/><geometry><sphere radius="0.006"/></geometry></collision>
    <collision><origin xyz="-0.1515 -0.047 -0.0265"/><geometry><sphere radius="0.006"/></geometry></collision>
  </link>
  <joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster_link"/></joint>

  <!-- 카메라: IMX219, 320x240에서 fx=fy=230.0 (교재 ArUco 예제와 같은 내부 파라미터), 아래로 8.0° -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.06 0.0 0.0625" rpy="0 0.139626 0"/>
  </joint>
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="-0.03 0.0 -0.0025"/>
  </joint>

  <!-- LiDAR (옵션 액세서리): 받침 = 제조사 URDF, 센서 모양 = MentorPi URDF의 lidar_Link 메시 (© Hiwonder) -->
  <link name="laser_mount_link">
    <visual><geometry><mesh filename="package://tiki_description/meshes/lidar_mount.stl"/></geometry><material name="hub"/></visual>
    <visual><geometry><mesh filename="package://tiki_description/meshes/lidar.stl"/></geometry><material name="lidar"/></visual>
  </link>
  <joint name="laser_mount_joint" type="fixed">
    <parent link="base_link"/><child link="laser_mount_link"/>
    <origin xyz="-0.1025 0.0 0.0290"/>
  </joint>
  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_link"/>
    <origin xyz="-0.1025 0.0 0.1012" rpy="0 0 0"/>
  </joint>

  <!-- 표시 장치 위치 (시각화용 프레임) — OLED는 왼쪽 옆판 뒤쪽의 사각 구멍 안 -->
  <link name="oled_link">
    <!-- 1.3인치 OLED 모듈: 옆판 구멍을 채우는 검은 테두리 + 화면 (x = 옆판 바깥쪽, y = 뒤쪽, z = 위).
         웹 뷰어는 화면 바로 앞에 글자를 그린 판(canvas)을 덧붙인다. -->
    <visual><geometry><box size="0.002 0.0350 0.0240"/></geometry><material name="oled_bezel"/></visual>
    <visual><origin xyz="0.0008 0 0"/><geometry><box size="0.0004 0.0310 0.0155"/></geometry><material name="oled_screen"/></visual>
  </link>
  <joint name="oled_joint" type="fixed">
    <parent link="base_link"/><child link="oled_link"/>
    <origin xyz="-0.117 0.1055 0.0040" rpy="0 0 1.570796"/>
  </joint>
  <link name="led_link">
    <!-- WS2812 RGB LED 8개 (x = 뒷면 바깥쪽, 0번 = 뒤에서 볼 때 왼쪽). 웹 뷰어는 같은 자리에 색이 바뀌는 LED를 덧그린다. -->
    <visual><origin xyz="0.0006 -0.0420 0"/><geometry><box size="0.0016 0.0056 0.0056"/></geometry><material name="led"/></visual>
    <visual><origin xyz="0.0006 -0.0300 0"/><geometry><box size="0.0016 0.0056 0.0056"/></geometry><material name="led"/></visual>
    <visual><origin xyz="0.0006 -0.0180 0"/><geometry><box size="0.0016 0.0056 0.0056"/></geometry><material name="led"/></visual>
    <visual><origin xyz="0.0006 -0.0060 0"/><geometry><box size="0.0016 0.0056 0.0056"/></geometry><material name="led"/></visual>
    <visual><origin xyz="0.0006 0.0060 0"/><geometry><box size="0.0016 0.0056 0.0056"/></geometry><material name="led"/></visual>
    <visual><origin xyz="0.0006 0.0180 0"/><geometry><box size="0.0016 0.0056 0.0056"/></geometry><material name="led"/></visual>
    <visual><origin xyz="0.0006 0.0300 0"/><geometry><box size="0.0016 0.0056 0.0056"/></geometry><material name="led"/></visual>
    <visual><origin xyz="0.0006 0.0420 0"/><geometry><box size="0.0016 0.0056 0.0056"/></geometry><material name="led"/></visual>
  </link>
  <joint name="led_joint" type="fixed">
    <parent link="base_link"/><child link="led_link"/>
    <origin xyz="-0.1809 0 0.0020" rpy="0 0 3.141593"/>
  </joint>
</robot>
