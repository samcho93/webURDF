<?xml version="1.0"?>
<!-- 자동 생성 파일 — 수정하려면 ros2_ws/gen_macro.py 를 고치고 다시 실행하세요. -->
<!-- 조인트 수치는 TheRobotStudio/SO-ARM100 의 so101_new_calib.urdf 원본과 동일합니다. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="printed"><color rgba="0.94 0.75 0.11 1.0"/></material>
  <material name="servo"><color rgba="0.16 0.20 0.25 1.0"/></material>

  <xacro:macro name="so_arm101" params="prefix:='' parent:=world *origin">

    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child  link="${prefix}base_link"/>
    </joint>

  <link name="${prefix}base_link">
    <inertial>
      <origin xyz="0.012 0 0.028" rpy="0 0 0"/>
      <mass value="0.147"/>
      <inertia ixx="1.990625e-04" ixy="0" ixz="0" iyy="1.721125e-04" iyz="0" izz="2.970625e-04"/>
    </inertial>
    <visual>
      <origin xyz="0.012 0 0.028" rpy="0 0 0"/>
      <geometry><box size="0.105 0.115 0.055"/></geometry>
      <material name="printed"/>
    </visual>
    <collision>
      <origin xyz="0.012 0 0.028" rpy="0 0 0"/>
      <geometry><box size="0.105 0.115 0.055"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.03 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.048 0.055 0.052"/></geometry>
      <material name="servo"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.048 0.055 0.052"/></geometry>
    </collision>
  </link>

  <link name="${prefix}shoulder_link">
    <inertial>
      <origin xyz="-0.03 0 -0.028" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="5.286667e-05" ixy="0" ixz="0" iyy="6.166667e-05" iyz="0" izz="7.286667e-05"/>
    </inertial>
    <visual>
      <origin xyz="-0.03 0 -0.028" rpy="0 0 0"/>
      <geometry><box size="0.07 0.062 0.05"/></geometry>
      <material name="printed"/>
    </visual>
    <collision>
      <origin xyz="-0.03 0 -0.028" rpy="0 0 0"/>
      <geometry><box size="0.07 0.062 0.05"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.03 -0.014 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.05 0.052 0.045"/></geometry>
      <material name="servo"/>
    </visual>
    <collision>
      <origin xyz="-0.03 -0.014 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.05 0.052 0.045"/></geometry>
    </collision>
  </link>

  <link name="${prefix}upper_arm_link">
    <inertial>
      <origin xyz="-0.058 -0.014 0.018" rpy="0 0 0"/>
      <mass value="0.103"/>
      <inertia ixx="3.659933e-05" ixy="0" ixz="0" iyy="2.082660e-04" iyz="0" izz="2.145833e-04"/>
    </inertial>
    <visual>
      <origin xyz="-0.058 -0.014 0.018" rpy="0 0 0"/>
      <geometry><box size="0.15 0.05 0.042"/></geometry>
      <material name="printed"/>
    </visual>
    <collision>
      <origin xyz="-0.058 -0.014 0.018" rpy="0 0 0"/>
      <geometry><box size="0.15 0.05 0.042"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.112 -0.028 0.018" rpy="0 0 0"/>
      <geometry><box size="0.05 0.046 0.052"/></geometry>
      <material name="servo"/>
    </visual>
    <collision>
      <origin xyz="-0.112 -0.028 0.018" rpy="0 0 0"/>
      <geometry><box size="0.05 0.046 0.052"/></geometry>
    </collision>
  </link>

  <link name="${prefix}lower_arm_link">
    <inertial>
      <origin xyz="-0.07 0.004 0.018" rpy="0 0 0"/>
      <mass value="0.104"/>
      <inertia ixx="3.220533e-05" ixy="0" ixz="0" iyy="2.088667e-04" iyz="0" izz="2.133387e-04"/>
    </inertial>
    <visual>
      <origin xyz="-0.07 0.004 0.018" rpy="0 0 0"/>
      <geometry><box size="0.15 0.046 0.04"/></geometry>
      <material name="printed"/>
    </visual>
    <collision>
      <origin xyz="-0.07 0.004 0.018" rpy="0 0 0"/>
      <geometry><box size="0.15 0.046 0.04"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.135 0.005 0.018" rpy="0 0 0"/>
      <geometry><box size="0.048 0.046 0.05"/></geometry>
      <material name="servo"/>
    </visual>
    <collision>
      <origin xyz="-0.135 0.005 0.018" rpy="0 0 0"/>
      <geometry><box size="0.048 0.046 0.05"/></geometry>
    </collision>
  </link>

  <link name="${prefix}wrist_link">
    <inertial>
      <origin xyz="0 -0.034 0.024" rpy="0 0 0"/>
      <mass value="0.079"/>
      <inertia ixx="5.096158e-05" ixy="0" ixz="0" iyy="2.786067e-05" iyz="0" izz="5.096158e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.034 0.024" rpy="0 0 0"/>
      <geometry><box size="0.046 0.075 0.046"/></geometry>
      <material name="printed"/>
    </visual>
    <collision>
      <origin xyz="0 -0.034 0.024" rpy="0 0 0"/>
      <geometry><box size="0.046 0.075 0.046"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 -0.052 0.024" rpy="0 0 0"/>
      <geometry><box size="0.044 0.048 0.046"/></geometry>
      <material name="servo"/>
    </visual>
    <collision>
      <origin xyz="0 -0.052 0.024" rpy="0 0 0"/>
      <geometry><box size="0.044 0.048 0.046"/></geometry>
    </collision>
  </link>

  <link name="${prefix}gripper_link">
    <inertial>
      <origin xyz="0.004 0 -0.022" rpy="0 0 0"/>
      <mass value="0.087"/>
      <inertia ixx="3.204500e-05" ixy="0" ixz="0" iyy="3.204500e-05" iyz="0" izz="3.068200e-05"/>
    </inertial>
    <visual>
      <origin xyz="0.004 0 -0.022" rpy="0 0 0"/>
      <geometry><box size="0.046 0.046 0.048"/></geometry>
      <material name="servo"/>
    </visual>
    <collision>
      <origin xyz="0.004 0 -0.022" rpy="0 0 0"/>
      <geometry><box size="0.046 0.046 0.048"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.008 0 -0.068" rpy="0 0 0"/>
      <geometry><box size="0.016 0.03 0.07"/></geometry>
      <material name="printed"/>
    </visual>
    <collision>
      <origin xyz="-0.008 0 -0.068" rpy="0 0 0"/>
      <geometry><box size="0.016 0.03 0.07"/></geometry>
    </collision>
  </link>

  <link name="${prefix}moving_jaw_so101_v1_link">
    <inertial>
      <origin xyz="-0.002 -0.03 0.014" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="5.000000e-06" ixy="0" ixz="0" iyy="1.352000e-06" iyz="0" izz="4.040000e-06"/>
    </inertial>
    <visual>
      <origin xyz="-0.002 -0.03 0.014" rpy="0 0 0"/>
      <geometry><box size="0.014 0.062 0.034"/></geometry>
      <material name="printed"/>
    </visual>
    <collision>
      <origin xyz="-0.002 -0.03 0.014" rpy="0 0 0"/>
      <geometry><box size="0.014 0.062 0.034"/></geometry>
    </collision>
  </link>

  <!-- 서보 ID 1 -->
  <joint name="${prefix}shoulder_pan" type="revolute">
    <origin xyz="0.0388353 0 0.0624" rpy="3.14159 0 -3.14159"/>
    <parent link="${prefix}base_link"/>
    <child  link="${prefix}shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="3.0" lower="-1.91986" upper="1.91986"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- 서보 ID 2 -->
  <joint name="${prefix}shoulder_lift" type="revolute">
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <parent link="${prefix}shoulder_link"/>
    <child  link="${prefix}upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="3.0" lower="-1.74533" upper="1.74533"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- 서보 ID 3 -->
  <joint name="${prefix}elbow_flex" type="revolute">
    <origin xyz="-0.11257 -0.028 0" rpy="0 0 1.5708"/>
    <parent link="${prefix}upper_arm_link"/>
    <child  link="${prefix}lower_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="3.0" lower="-1.69" upper="1.69"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- 서보 ID 4 -->
  <joint name="${prefix}wrist_flex" type="revolute">
    <origin xyz="-0.1349 0.0052 0" rpy="0 0 -1.5708"/>
    <parent link="${prefix}lower_arm_link"/>
    <child  link="${prefix}wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="3.0" lower="-1.65806" upper="1.65806"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- 서보 ID 5 -->
  <joint name="${prefix}wrist_roll" type="revolute">
    <origin xyz="0 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/>
    <parent link="${prefix}wrist_link"/>
    <child  link="${prefix}gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="3.0" lower="-2.74385" upper="2.84121"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- 서보 ID 6 -->
  <joint name="${prefix}gripper" type="revolute">
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 0 0"/>
    <parent link="${prefix}gripper_link"/>
    <child  link="${prefix}moving_jaw_so101_v1_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="3.0" lower="-0.174533" upper="1.74533"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- TCP(툴 중심점) — MoveIt 의 엔드 이펙터 링크 -->
  <link name="${prefix}gripper_frame_link"/>
  <joint name="${prefix}gripper_frame_joint" type="fixed">
    <origin xyz="-0.0079 -0.000218121 -0.0981274" rpy="0 3.14159 0"/>
    <parent link="${prefix}gripper_link"/>
    <child  link="${prefix}gripper_frame_link"/>
  </joint>

  </xacro:macro>
</robot>
