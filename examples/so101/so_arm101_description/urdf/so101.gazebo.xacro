<?xml version="1.0"?>
<!-- Gazebo(gz-sim) 전용 설정: 재질, 마찰, gz_ros2_control 플러그인 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="so_arm101_gazebo" params="hardware_type:=mock prefix:=''">
    <xacro:if value="${hardware_type == 'gazebo'}">

      <gazebo>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find so_arm101_description)/config/controllers.yaml</parameters>
        </plugin>
      </gazebo>

      <xacro:macro name="gz_link" params="name color">
        <gazebo reference="${prefix}${name}">
          <material>${color}</material>
          <mu1>0.9</mu1>
          <mu2>0.9</mu2>
          <self_collide>false</self_collide>
        </gazebo>
      </xacro:macro>

      <xacro:gz_link name="base_link"      color="Gazebo/Yellow"/>
      <xacro:gz_link name="shoulder_link"  color="Gazebo/Yellow"/>
      <xacro:gz_link name="upper_arm_link" color="Gazebo/Yellow"/>
      <xacro:gz_link name="lower_arm_link" color="Gazebo/Yellow"/>
      <xacro:gz_link name="wrist_link"     color="Gazebo/Yellow"/>

      <!-- 그리퍼는 물체를 잡아야 하므로 마찰을 높인다 -->
      <gazebo reference="${prefix}gripper_link">
        <material>Gazebo/DarkGrey</material>
        <mu1>1.4</mu1>
        <mu2>1.4</mu2>
      </gazebo>
      <gazebo reference="${prefix}moving_jaw_so101_v1_link">
        <material>Gazebo/DarkGrey</material>
        <mu1>1.4</mu1>
        <mu2>1.4</mu2>
      </gazebo>

    </xacro:if>
  </xacro:macro>
</robot>
